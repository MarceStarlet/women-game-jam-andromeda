[sub_resource type="GDScript" id="GDScript_7eb1j"]
script/source = "extends Control

func _on_comenzar_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/levels/level_1/level_1.tscn\")


func _on_salir_button_pressed() -> void:
	get_tree().quit()


func _on_creditos_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://creditos.tscn\")
"

